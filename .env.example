# Main model: Kun default Grok via sub2api (OpenAI-compatible)
HARNESS_MODEL=xai/grok-4.5
HARNESS_BASE_URL=https://sub2api-production-3d63.up.railway.app/v1
HARNESS_API_KEY=

# Small model: DeepSeek (compact / child explore)
HARNESS_SMALL_MODEL=deepseek-v4-flash
HARNESS_SMALL_BASE_URL=https://api.deepseek.com/v1
HARNESS_SMALL_API_KEY=

TAVILY_API_KEY=

# Local Redis first; switch to cloud by changing only this URL.
REDIS_URL=redis://127.0.0.1:6379/0

# Supabase persistence (service role stays on the server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Handshake token returned by GET /
HARNESS_HANDSHAKE_TOKEN=harness-ok

# Compact 触发阈值（字符数，默认 100000 ≈ 28K token）。想更晚压缩就调大。
HARNESS_COMPACT_CHARS=100000
